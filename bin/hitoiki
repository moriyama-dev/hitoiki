#!/usr/bin/python3
import os
import sys

# インストール先（/usr/share/hitoiki）か、リポジトリ直下から起動する
for path in ("/usr/share/hitoiki", os.path.join(os.path.dirname(__file__), "..")):
    if os.path.isdir(os.path.join(path, "hitoiki")):
        sys.path.insert(0, os.path.abspath(path))
        break

from hitoiki.app import main  # noqa: E402

sys.exit(main(sys.argv))
